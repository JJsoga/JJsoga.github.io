---
import BaseLayout from '../layouts/BaseLayout.astro';
import Playground from '../components/Playground.astro';
import WordDice from '../components/WordDice.astro';
import { siteBrand } from '../data/site';

const homeHref = import.meta.env.BASE_URL;
const faviconHref = `${homeHref.replace(/\/$/, '')}/favicon.svg`;
---

<BaseLayout
	title="Play | Hexin Chen"
	description="A small playground for curious cursors and words. Push, throw, and scatter letters and images, leave a trail, or roll a generated line with Word Dice."
	socialImageAlt="Hexin Chen's personal website"
	translatedPage={false}
>
	<header class="site-header">
		<div class="nav-shell play-nav">
			<a class="brand" href={homeHref} aria-label="JJsoga — home">
				<img class="brand-mark" src={faviconHref} alt="" width="32" height="32" />
				<span class="brand-name">{siteBrand.name}</span>
			</a>
			<nav aria-label="Main navigation">
				<a class="play-home" href={homeHref}><span aria-hidden="true">←</span> Back home</a>
			</nav>
		</div>
	</header>

	<main id="main-content" class="play-page">
		<section class="play-intro" aria-labelledby="play-title">
			<p class="section-kicker">Play / experiment 001</p>
			<h1 id="play-title">A little room to play.</h1>
			<p>Give a letter a nudge. Throw an image around. Make a little mess, then bring it all back.</p>
		</section>

		<Playground />
		<WordDice />

		<footer class="play-footer">
			<p>A small, ongoing experiment in how a page can respond to you.</p>
			<a href={homeHref}>Back to the usual things <span aria-hidden="true">↗</span></a>
		</footer>
	</main>
</BaseLayout>
