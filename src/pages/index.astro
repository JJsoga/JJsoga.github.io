---
import BaseLayout from '../layouts/BaseLayout.astro';
import FlagshipProjectCard from '../components/FlagshipProjectCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { awards, courseworkGroups, navigation, profile, siteMetadata } from '../data/profile';
import { currentProject, flagshipProjects } from '../data/projects';

const currentYear = new Date().getFullYear();
---

<BaseLayout title={siteMetadata.title} description={siteMetadata.description}>
	<header class="site-header">
		<div class="nav-shell">
			<a class="brand" href="#top" aria-label="Hexin Chen — back to top">
				<span class="brand-mark" aria-hidden="true">HC</span>
				<span class="brand-name">Hexin Chen</span>
			</a>
			<nav class="primary-nav" aria-label="Primary navigation">
				<ul>
					{navigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
				</ul>
			</nav>
		</div>
	</header>

	<main id="main-content">
		<section class="hero" id="top" aria-labelledby="hero-title">
			<div class="hero__inner">
				<div class="hero__copy">
					<h1 id="hero-title">{profile.name}</h1>
					<p class="hero__headline">{profile.program} at {profile.university}</p>
					<p class="hero__bio">{profile.bio}</p>
					<ul class="hero__facts" aria-label="Academic standing">
						<li><strong>{profile.education.gpa}</strong></li>
						<li><strong>{profile.education.rank}</strong></li>
						<li><span>{profile.university} · {profile.education.period}</span></li>
					</ul>
					<div class="hero__actions" aria-label="Profile links">
						{
							profile.links.map((link, index) => (
								<a
									class:list={['button', index > 0 && 'button--secondary']}
									href={link.href ?? undefined}
									target={link.external ? '_blank' : undefined}
									rel={link.external ? 'noreferrer' : undefined}
								>
									{link.label} <span aria-hidden="true">↗</span>
								</a>
							))
						}
					</div>
				</div>
			</div>
			<a class="scroll-cue" href="#work">
				<span>Selected work</span>
				<span aria-hidden="true">↓</span>
			</a>
		</section>

		<section class="section work" id="work" aria-labelledby="work-title">
			<h2 class="section-kicker section-label" id="work-title">01 / Selected Work</h2>
			<div class="flagship-grid">
				{flagshipProjects.map((project) => <FlagshipProjectCard project={project} />)}
			</div>
			<ProjectCard project={currentProject} />
		</section>

		<section class="section education" id="education" aria-labelledby="education-title">
			<h2 class="section-kicker section-label" id="education-title">02 / Education & Coursework</h2>
			<div class="education-group">
				<article class="education-card">
					<div>
						<p class="education-card__period">{profile.university} · {profile.education.period}</p>
						<h3>{profile.program}</h3>
					</div>
					<div class="education-card__standing">
						<span>Academic standing</span>
						<div>
							<strong>{profile.education.gpa}</strong>
							<strong>{profile.education.rank}</strong>
						</div>
					</div>
				</article>
				<div class="coursework-panel">
					<p class="coursework-label">Selected coursework</p>
					<div class="coursework-groups">
						{courseworkGroups.map((group) => (
							<section class="coursework-group" aria-labelledby={`coursework-${group.label.toLowerCase().replaceAll(/[^a-z]+/g, '-')}`}>
								<h3 id={`coursework-${group.label.toLowerCase().replaceAll(/[^a-z]+/g, '-')}`}>{group.label}</h3>
								<ul>
									{group.courses.map((course) => <li>{course}</li>)}
								</ul>
							</section>
						))}
					</div>
				</div>
			</div>
		</section>

		<section class="section awards" id="awards" aria-labelledby="awards-title">
			<h2 class="section-kicker section-label" id="awards-title">03 / Awards</h2>
			<ul class="award-list">
				{awards.map((award) => <li><strong>{award}</strong></li>)}
			</ul>
		</section>

		<section class="contact" id="contact" aria-labelledby="contact-title">
			<div class="contact__inner">
				<div class="contact__intro">
					<h2 class="section-kicker section-kicker--light" id="contact-title">04 / Contact</h2>
					<p>I welcome conversations about quantitative research, machine learning, statistical modeling, and data-driven systems.</p>
				</div>
				<div class="contact-links" aria-label="Contact links">
					{
						profile.links.map((link) => (
							<a
								href={link.href ?? undefined}
								target={link.external ? '_blank' : undefined}
								rel={link.external ? 'noreferrer' : undefined}
							>
								{link.label}<span aria-hidden="true">↗</span>
							</a>
						))
					}
				</div>
			</div>
		</section>
	</main>

	<footer class="site-footer">
		<div>
			<p>© {currentYear} {profile.name}</p>
			<p>{profile.university}</p>
			<a href="#top">Back to top <span aria-hidden="true">↑</span></a>
		</div>
	</footer>
</BaseLayout>
