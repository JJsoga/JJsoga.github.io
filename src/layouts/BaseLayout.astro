---
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	lang?: 'en' | 'zh-CN';
	skipLinkText?: string;
	socialImageAlt: string;
	siteName: string;
}

const {
	title,
	description,
	lang = 'en',
	skipLinkText = 'Skip to content',
	socialImageAlt,
	siteName,
} = Astro.props;
const basePath = import.meta.env.BASE_URL;
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const assetBase = basePath.endsWith('/') ? basePath : `${basePath}/`;
const socialImageURL = new URL(`${assetBase}og.png`, Astro.site ?? Astro.url);
const englishURL = new URL(assetBase, Astro.site ?? Astro.url);
const chineseURL = new URL(`${assetBase}zh/`, Astro.site ?? Astro.url);
const isChinese = lang === 'zh-CN';
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f5f5f1" />
		<link rel="icon" type="image/svg+xml" href={`${assetBase}favicon.svg`} />
		<link rel="canonical" href={canonicalURL} />
		<link rel="alternate" hreflang="en" href={englishURL} />
		<link rel="alternate" hreflang="zh-CN" href={chineseURL} />
		<link rel="alternate" hreflang="x-default" href={englishURL} />
		{isChinese && (
			<>
				<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin="anonymous" />
				<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lxgw-wenkai-webfont@1.7.0/lxgwwenkai-regular.css" />
				<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lxgw-wenkai-webfont@1.7.0/lxgwwenkai-bold.css" />
			</>
		)}
		<title>{title}</title>

		<meta property="og:type" content="website" />
		<meta property="og:locale" content={isChinese ? 'zh_CN' : 'en_US'} />
		<meta property="og:locale:alternate" content={isChinese ? 'en_US' : 'zh_CN'} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:image" content={socialImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={socialImageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageURL} />
		<meta name="twitter:image:alt" content={socialImageAlt} />
	</head>
	<body>
		<a class="skip-link" href="#main-content">{skipLinkText}</a>
		<slot />
	</body>
</html>
